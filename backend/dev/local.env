# Local development settings (matches local/compose.yaml). Not used in AWS.
# NOT REAL SECRETS: the passwords and keys below are fixed placeholders for the local
# Docker containers (Postgres, MinIO), which listen on 127.0.0.1 only. They are committed
# on purpose so `./scripts/dev.sh` works out of the box. Never put real credentials here.
PORT=3001

DB_HOST=localhost
DB_PORT=5432
DB_NAME=app
DB_USER=app_admin
DB_PASSWORD=localdev                  # local Docker Postgres only, not a secret
DB_SSL=false

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=localdev            # MinIO root user, not an AWS key
AWS_SECRET_ACCESS_KEY=localdev-secret # MinIO root password, not an AWS secret
S3_ENDPOINT=http://localhost:9000
BUCKET=attachments

MAX_BYTES=2097152
MAX_PER_ITEM=10
