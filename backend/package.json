{
  "name": "crud-api",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=dev/local.env --watch dev/server.mjs",
    "test": "node --test test/*.test.mjs",
    "build": "esbuild src/items.mjs src/attachments.mjs --bundle --platform=node --target=node22 --format=cjs --minify --sourcemap --external:pg-native --outdir=dist --entry-names=[name]/index"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/rds-signer": "^3.700.0",
    "@aws-sdk/s3-presigned-post": "^3.700.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
